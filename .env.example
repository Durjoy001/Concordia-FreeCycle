# ---- Database ----
# Local (docker compose) value; the api service overrides host to `postgres`.
DATABASE_URL=postgresql+psycopg://freecycle:freecycle@localhost:5432/freecycle

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-48-byte-url-safe-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Agent layer ----
ANTHROPIC_API_KEY=sk-ant-...
# Vision-capable model used by every MCP tool and the orchestrator.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Max agent runs per user per rolling 24h. Set to 0 to disable the agent layer.
AGENT_DAILY_BUDGET=20
AGENT_ENABLED=true
AGENT_MAX_RETRIES=3
# Minimum semantic score (0..1) for a wishlist match to produce a notification.
MATCH_SCORE_THRESHOLD=0.6

# ---- MCP server ----
# http  -> orchestrator connects to MCP_SERVER_URL (docker compose default)
# stdio -> orchestrator spawns MCP_SERVER_COMMAND as a subprocess (bare-metal dev)
MCP_TRANSPORT=http
MCP_SERVER_URL=http://localhost:8765/mcp
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=mcp-server/server.py --transport stdio

# ---- Storage ----
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
# Per-photo upload ceiling, enforced while streaming (8 MiB).
MAX_UPLOAD_BYTES=8388608

# ---- API ----
API_PREFIX=/api/v1

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend (frontend/.env) ----
# VITE_API_BASE_URL=http://localhost:8000/api/v1
